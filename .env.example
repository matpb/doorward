# Copy this file to .env and set the address. See docs/DOCKER.md for every setting.
# Public address of the gateway: https, a host name, and a port only when it is not 443.
DOORWARD_PUBLIC_URL=https://doorward.example.com
# Host ports that Caddy publishes (compose.caddy.yaml only).
HTTP_PORT=80
HTTPS_PORT=443
# Image the stacks run. The default is built from this repository.
IMAGE=doorward:local
